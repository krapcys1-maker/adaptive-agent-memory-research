{
  "artifact": "arena-cross-unit-contamination-audit",
  "recorded_at": "2026-08-24T06:07:30+00:00",
  "scope": "every Mem0 and Hindsight run over arena-pilot-v1 and arena-expansion-v1; all used the same adapters and the same reset path",
  "no_paid_calls": true,
  "root_cause": {
    "confirmed": true,
    "where": "mem0/memory/main.py Memory.delete_all",
    "what": "delete_all resolves the rows to remove with self.vector_store.list(filters=filters)[0] and passes NO limit. QdrantVectorStore.list has limit: int = 100. So one delete_all call removes at most 100 memories, whatever the store holds.",
    "proved_empirically": "250 memories stored, delete_all left 150, a second call left 50. Exactly 100 per call, no LLM involved.",
    "our_contribution": "the adapter wrapped delete_all in `try/except Exception: pass` and never verified the store was empty afterwards. The cap is Mem0's; not checking the postcondition is ours.",
    "why_units_were_affected": "every unit stored 220-392 memories, so every reset left 120-292 behind"
  },
  "verdict": {
    "mem0": "CONTAMINATED \u2014 confirmed",
    "hindsight": "CLEAN \u2014 confirmed"
  },
  "hindsight_false_alarm": {
    "raw_number": "585 of 1458 delivered evidence items carried a date not in the unit's haystack",
    "resolution": "ZERO of those 585 map to any other unit in the selection. They are dates Hindsight derived from content rather than session timestamps. Hindsight's reset_returns_to_empty is True on all ten units. The 585 figure was an artefact of the audit metric, not contamination, and would have been a false accusation."
  },
