{
  "schema_version": "pmlab-map-stage-case-v1",
  "required_common_fields": [
    "case_id",
    "semantic_group_id",
    "stage",
    "language",
    "criticality",
    "split",
    "input",
    "gold",
    "provenance",
    "evaluation_metadata"
  ],
  "allowed_stages": [
    "contract_span",
    "obligation_graph",
    "entity_linking",
    "predicate_linking",
    "time_authorization",
    "certificate_routing"
  ],
  "common_contract": {
    "language": ["en", "pl"],
    "criticality": ["ordinary", "critical"],
    "split": ["stage-dev-v1", "stage-challenge-v1"],
    "paired_languages_per_semantic_group": true,
    "candidate_output_excluded_from_gold": true
  },
  "stage_outputs": {
    "contract_span": {
      "decision": ["accept", "typed_reject"],
      "reject_reason": ["none", "invalid_serialization", "missing_required_field", "non_source_span", "invalid_dependency", "unknown_catalog_id", "unsafe_unresolved_state"],
      "required_metrics": ["schema_valid", "contract_valid", "wrong_valid_contract", "typed_reject_exact"]
    },
    "obligation_graph": {
      "query_status": ["resolved", "ambiguous", "unauthorized", "unsupported_structure"],
      "node_fields": ["obligation_id", "operator", "source_span", "depends"],
      "required_metrics": ["obligation_precision", "obligation_recall", "critical_full_recall", "structure_exact", "unsupported_coercion"]
    },
    "entity_linking": {
      "action": ["linked", "ambiguous_in_catalog", "missing_entity", "non_entity_phrase", "mention_not_detected"],
      "fields": ["ranked_candidates", "selected_id", "mention_span", "type_basis"],
      "required_metrics": ["candidate_recall_at_5", "top1_accuracy", "nil_subtype_accuracy", "false_link_rate", "risk_coverage_auc"]
    },
    "predicate_linking": {
      "action": ["linked", "ambiguous_schema", "unsupported_predicate"],
      "fields": ["ranked_predicates", "selected_predicate", "selected_namespaces", "span"],
      "required_metrics": ["candidate_recall_at_5", "top1_accuracy", "false_positive_rate", "retained_schema_fraction", "risk_coverage_auc"]
    },
    "time_authorization": {
      "time_status": ["resolved", "ambiguous", "unbounded", "unsupported", "inherited"],
      "authorization_status": ["allowed", "denied", "partial", "inherited"],
      "fields": ["raw_span", "normalized_time", "timezone", "reference_clock", "principal", "policy_basis"],
      "required_metrics": ["time_structure_exact", "interval_or_anchor_exact", "ambiguous_safe", "authorization_exact", "unauthorized_exposure"]
    },
    "certificate_routing": {
      "certificate_status": ["applicable", "derived", "explicit_negative", "requires_complete_scope", "ambiguous", "inapplicable"],
      "action": ["answer", "continue_search", "clarify", "partial_with_gap", "abstain"],
      "required_metrics": ["certificate_exact", "action_exact", "false_explicit_negative", "false_collection_absence", "insertion_detection"]
    }
  },
  "provenance_required": [
    "author_id",
    "authored_at",
    "schema_or_catalog_version",
    "source_or_construction_basis",
    "review_status"
  ],
  "review_statuses": ["unreviewed", "reviewed_agree", "reviewed_disagree", "adjudicated", "excluded"]
}
