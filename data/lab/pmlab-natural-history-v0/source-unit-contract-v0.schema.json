{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krapcys1-maker/adaptive-agent-memory-research/data/lab/pmlab-natural-history-v0/source-unit-contract-v0.schema.json",
  "title": "PMLAB natural-history source unit v0",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"git_object_format": {"const": "sha1"}}, "required": ["git_object_format"]},
      "then": {"properties": {"snapshot_commit": {"pattern": "^[a-f0-9]{40}$"}}}
    },
    {
      "if": {"properties": {"git_object_format": {"const": "sha256"}}, "required": ["git_object_format"]},
      "then": {"properties": {"snapshot_commit": {"pattern": "^[a-f0-9]{64}$"}}}
    }
  ],
  "required": [
    "contract_version",
    "unit_id",
    "snapshot_commit",
    "git_object_format",
    "source_type",
    "path",
    "locator",
    "search_text",
    "search_text_sha256",
    "source_blob_sha256",
    "source_git_object",
    "eligibility_class",
    "backend_visible_fields"
  ],
  "properties": {
    "contract_version": {
      "const": "0.2.0"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^U-[a-f0-9]{16}$",
      "description": "Opaque ID derived from contract version, source type, path, locator, and search-text hash. Snapshot commit is excluded so an unchanged unit keeps its ID across historical snapshots. It must not encode time, category, or relevance."
    },
    "snapshot_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "git_object_format": {
      "enum": ["sha1", "sha256"]
    },
    "source_type": {
      "enum": [
        "project_memory_event",
        "markdown_section",
        "catalog_row",
        "lab_summary_section"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["event_id", "heading_path_and_occurrence", "row_primary_key"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "search_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$",
      "description": "The byte-identical UTF-8 text passed to every retrieval representation before its documented tokenizer."
    },
    "search_text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_blob_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Portable SHA-256 of the exact historical file bytes, distinct from Git's typed object name."
    },
    "source_git_object": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"algorithm": {"const": "sha1"}}, "required": ["algorithm"]},
          "then": {"properties": {"object_id": {"pattern": "^[a-f0-9]{40}$"}}}
        },
        {
          "if": {"properties": {"algorithm": {"const": "sha256"}}, "required": ["algorithm"]},
          "then": {"properties": {"object_id": {"pattern": "^[a-f0-9]{64}$"}}}
        }
      ],
      "required": ["algorithm", "object_id"],
      "properties": {
        "algorithm": {"enum": ["sha1", "sha256"]},
        "object_id": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}
      }
    },
    "eligibility_class": {
      "enum": [
        "canonical_research",
        "canonical_memory",
        "reviewed_lab_summary",
        "reviewed_catalog"
      ]
    },
    "valid_time": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "recorded_time": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": ["string", "null"]
    },
    "trust": {
      "type": ["string", "null"]
    },
    "source_aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "locator"],
        "properties": {
          "path": {"type": "string"},
          "locator": {"type": "string"}
        }
      },
      "description": "Exact duplicate byte sources collapsed before ranking; near duplicates are not collapsed."
    },
    "split_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "part_index", "part_count", "overlap_utf8_bytes"],
      "properties": {
        "method": {"enum": ["commonmark_block_boundary", "unicode_whitespace_boundary", "utf8_codepoint_boundary"]},
        "part_index": {"type": "integer", "minimum": 1},
        "part_count": {"type": "integer", "minimum": 2},
        "overlap_utf8_bytes": {"const": 0}
      },
      "description": "Required on an oversized logical unit split under the frozen global byte ceiling. The locator value also carries the same part index."
    },
    "backend_visible_fields": {
      "const": ["unit_id", "search_text"],
      "description": "The primary B1/B2/C1/C2 comparison receives no path, filename, time, status, trust, or label."
    }
  }
}
