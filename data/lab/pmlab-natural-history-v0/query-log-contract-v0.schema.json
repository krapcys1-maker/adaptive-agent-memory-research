{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krapcys1-maker/adaptive-agent-memory-research/data/lab/pmlab-natural-history-v0/query-log-contract-v0.schema.json",
  "title": "PMLAB authentic pre-output query log v0",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"git_object_format": {"const": "sha1"}}, "required": ["git_object_format"]},
      "then": {"properties": {"query_cutoff_commit": {"pattern": "^[a-f0-9]{40}$"}}}
    },
    {
      "if": {"properties": {"git_object_format": {"const": "sha256"}}, "required": ["git_object_format"]},
      "then": {"properties": {"query_cutoff_commit": {"pattern": "^[a-f0-9]{64}$"}}}
    }
  ],
  "required": [
    "query_id",
    "recorded_at",
    "query_text",
    "language",
    "origin_type",
    "origin_receipt",
    "query_cutoff_commit",
    "git_object_format",
    "pre_output_attestation",
    "collection_phase",
    "recorded_by_role",
    "storage_class",
    "capture_sequence"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "pattern": "^Q-[a-f0-9]{16}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "query_text": {
      "type": "string",
      "minLength": 3
    },
    "language": {
      "enum": ["pl", "en", "mixed", "other"]
    },
    "origin_type": {
      "enum": [
        "verbatim_user_question",
        "pre-investigation_issue",
        "pre-answer_debug_question",
        "pre-evidence_reviewer_question",
        "authored_diagnostic_development_only"
      ]
    },
    "origin_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value", "generation"],
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "private_random_receipt"}}, "required": ["mode"]},
          "then": {
            "properties": {
              "value": {"pattern": "^OR-[a-f0-9]{32}$"},
              "generation": {"const": "csprng-128"}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "private_keyed_digest"}}, "required": ["mode"]},
          "then": {
            "required": ["key_id"],
            "properties": {
              "value": {"pattern": "^KD-[a-f0-9]{64}$"},
              "generation": {"const": "hmac-sha256"},
              "key_id": {"pattern": "^K-[a-f0-9]{16}$"}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "public_git_locator"}}, "required": ["mode"]},
          "then": {
            "required": ["repository_id"],
            "properties": {
              "value": {"pattern": "^git:(?:[a-f0-9]{40}|[a-f0-9]{64}):[^\\r\\n]+$"},
              "generation": {"const": "public-git-locator"},
              "repository_id": {"const": "adaptive-agent-memory-research-public"}
            }
          }
        }
      ],
      "properties": {
        "mode": {"enum": ["public_git_locator", "private_random_receipt", "private_keyed_digest"]},
        "value": {"type": "string", "minLength": 3},
        "generation": {"enum": ["public-git-locator", "csprng-128", "hmac-sha256"]},
        "key_id": {"type": "string"},
        "repository_id": {"type": "string"}
      },
      "description": "Public locators may be explicit. Private origins use an independently random receipt or keyed digest whose mapping/key remains outside Git; an unkeyed content or locator hash is forbidden."
    },
    "query_cutoff_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "git_object_format": {
      "enum": ["sha1", "sha256"]
    },
    "pre_output_attestation": {
      "const": "No candidate backend output or gold evidence search was viewed before this query was frozen."
    },
    "collection_phase": {
      "enum": ["retrospective_development", "prospective_test"]
    },
    "recorded_by_role": {
      "enum": ["user", "research_agent", "human_reviewer", "automated_capture"]
    },
    "storage_class": {
      "enum": ["git_public", "local_restricted"],
      "description": "Local-restricted query text and origin mappings must not be committed to the public repository; public artifacts expose opaque IDs and aggregate receipts only."
    },
    "capture_sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic position in the append-only capture log; supports ordering audits but does not prove blindness by itself."
    },
    "exclusion_reason": {
      "type": ["string", "null"]
    }
  }
}
