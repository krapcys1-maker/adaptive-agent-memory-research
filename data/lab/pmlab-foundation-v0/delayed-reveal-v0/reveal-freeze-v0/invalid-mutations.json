    {"case_id": "INV-FORK-DIFFERENT-PREFIX", "target": "reveals", "mutations": [{"op": "replace", "id": "RVL-0000000000000003", "path": "/prefix_id", "value": "PFX-FFFFFFFFFFFFFFFF"}], "expected_error": "reveal prefix join"},
    {"case_id": "INV-FORK-SAME-ANSWER-STATE", "target": "gold", "mutations": [{"op": "replace", "id": "GOLD-000000000002", "path": "/supported_answer_state", "value": "STATE-000000000001"}, {"op": "replace", "id": "GOLD-000000000003", "path": "/supported_answer_state", "value": "STATE-000000000001"}], "expected_error": "counterfactual answers not incompatible"},
