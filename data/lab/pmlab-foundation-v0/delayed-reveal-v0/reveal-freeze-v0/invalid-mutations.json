    {"case_id": "INV-READER-GOLD-VISIBLE", "target": "reveals", "mutations": [{"op": "replace", "id": "RVL-0000000000000001", "path": "/reader_visible_fields", "value": ["reveal_id", "query", "language", "gold_id"]}], "expected_error": "reader visible fields"},
    {"case_id": "INV-DUPLICATE-REVEAL-ID", "target": "reveals", "mutations": [{"op": "replace", "id": "RVL-0000000000000003", "path": "/reveal_id", "value": "RVL-0000000000000002"}], "expected_error": "duplicate reveal id"},
